    <string name="my_vehicles_help_title">How to use My vehicles on phone</string>
    <string name="my_vehicles_help_step_prepare">Prepare your vehicles at home, before an event, or whenever on your phone — tap “Add vehicle” on the “My vehicles on phone” screen, or on the “Model catalog” screen long-press a model and choose “Add to my vehicles”.</string>
    <string name="my_vehicles_help_step_edit">Fill in the vehicle name, DCC address and other details by long-pressing a vehicle and choosing “Edit”.</string>
    <string name="my_vehicles_help_step_login">When you are in range of a BigFred hub (for example at an event or at home), log in with the username and PIN you received from the organizers or set yourself.</string>
    <string name="my_vehicles_help_step_send">Select vehicles in “My vehicles on phone” and tap “Send selected” to send them to the BigFred hub you are connected to.</string>
    <string name="my_vehicles_help_step_layout">Then go back to “BigFred application”, open the “Mine” → “Vehicles” tab and tap the plus button to add a vehicle to the layout.</string>
    <string name="my_vehicles_help_step_done">Done! You can start driving.</string>
    <string name="my_vehicles_saved_sync_prompt">Saved on phone! You are currently connected to BigFred. Do you want to send the vehicle to the server?</string>
    <string name="my_vehicles_sync_prompt_later">Later</string>
    <string name="my_vehicles_sync_prompt_yes">Yes</string>
    <string name="my_vehicles_saved_offline_hint">When you connect to BigFred you can copy your vehicle to the server</string>

